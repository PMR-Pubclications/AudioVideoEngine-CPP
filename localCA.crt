#include <filesystem>
#include <iostream>

namespace fs = std::filesystem;

struct EnginePathConfig {
    fs::path caCertPath;
    fs::path clientCertPath;
    fs::path clientKeyPath;

    bool ResolvePaths() {
        // Example: Resolve relative to the running executable or standard config directory
        fs::path baseDir = fs::current_path();

        caCertPath = baseDir / "localCA.crt"; // In AudioVideoEngine-CPP repo
        
        // Pointing to the Trust-Shell managed certs directory (adjust relative depth as needed)
        fs::path trustShellDir = baseDir.parent_path() / "Trust-Shell";
        clientCertPath = trustShellDir / "client.crt";
        clientKeyPath = trustShellDir / "client.key";

        // Validate existence before passing to OpenSSL
        if (!fs::exists(caCertPath)) {
            std::cerr << "[Error] Missing localCA.crt at: " << caCertPath << std::endl;
            return false;
        }
        if (!fs::exists(clientCertPath) || !fs::exists(clientKeyPath)) {
            std::cerr << "[Error] Missing Trust-Shell client identity files." << std::endl;
            return false;
        }

        return true;
    }
};
